# Copy to .env for Docker Compose. Keep this file private after filling it.
# Required for the stack; use six independent, long random values.
WEBUI_SECRET_KEY=replace-with-long-random-secret
MH_TOKEN_ENCRYPTION_KEY=replace-with-independent-long-random-secret
MH_CONNECTOR_SECRET=replace-with-another-long-random-secret
MH_SANDBOX_TOKEN=replace-with-independent-sandbox-token
POSTGRES_PASSWORD=replace-with-independent-database-password
S3_SECRET_ACCESS_KEY=replace-with-independent-object-store-secret

# LLM: 1min.AI OpenAI-compatible API. URL is the API base, without /chat/completions.
# Leave the key empty to configure the connection later in Admin Settings > Connections.
OPENAI_API_BASE_URL=https://api.1min.ai/openai/v1
OPENAI_API_KEY=
MH_SMALL_TASK_MODEL=gpt-4.1-mini
MH_RESOURCE_TASK_MODEL=gpt-4.1-mini
MH_RESOURCE_AWARE_FILES=true
MH_RESOURCE_INDEX_WORKER_ENABLED=true
MH_AGENT_EXECUTION_V1=true
# Optional per-model capability overrides, keyed by model name or hostname/model name.
MH_MODEL_CAPABILITIES_JSON={}

# Origin of a separately served frontend (Vite dev defaults to this value).
CORS_ALLOW_ORIGIN=http://127.0.0.1:5173

# Google Drive sync: required only when connecting a real Google account.
# Register the redirect URI exactly in Google Cloud OAuth settings.
MH_GOOGLE_CLIENT_ID=
MH_GOOGLE_CLIENT_SECRET=
MH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/mini-hermes/drive/callback
