POSTGRES_PASSWORD=replace-with-dev-postgres-password
DATABASE_URL=postgresql://minihermes:${POSTGRES_PASSWORD}@postgres:5432/minihermes
REDIS_URL=redis://redis:6379/0
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_BUCKET_NAME=mini-hermes-dev
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=replace-with-dev-s3-secret
S3_ADDRESSING_STYLE=path
WEBUI_SECRET_KEY=replace-with-dev-webui-secret
MH_TOKEN_ENCRYPTION_KEY=replace-with-dev-token-encryption-key
MH_CONNECTOR_SECRET=replace-with-dev-connector-secret
MH_CONNECTOR_URL=http://google-connector:8090
MH_SANDBOX_URL=http://sandbox:8765
MH_SANDBOX_TOKEN=replace-with-dev-sandbox-token
OPENAI_API_BASE_URL=https://api.1min.ai/openai/v1
OPENAI_API_KEY=replace-with-1min-or-openai-key
MH_SMALL_TASK_MODEL=gpt-4.1-mini
MH_GOOGLE_CLIENT_ID=
MH_GOOGLE_CLIENT_SECRET=
MH_GOOGLE_REDIRECT_URI=https://dev-mini-hermes.ducnq.io.vn/api/v1/mini-hermes/drive/callback
FRONTEND_BUILD_DIR=/app/packages/backend/open_webui/frontend
ENABLE_VERSION_UPDATE_CHECK=false
USE_SLIM_DOCKER=true
ANONYMIZED_TELEMETRY=false
CORS_ALLOW_ORIGIN=https://dev-mini-hermes.ducnq.io.vn
DATA_DIR=/app/data
STATIC_DIR=/app/data/static
