POSTGRES_PASSWORD=replace-with-prod-postgres-password
AGENT_RUNTIME_ENVIRONMENT_ID=production
DATABASE_URL=postgresql://weai:${POSTGRES_PASSWORD}@postgres:5432/weai
REDIS_URL=redis://redis:6379/0
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_BUCKET_NAME=agent-runtime
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=replace-with-prod-s3-secret
S3_ADDRESSING_STYLE=path
WEAI_SECRET_KEY=replace-with-prod-webui-secret
AGENT_RUNTIME_TOKEN_ENCRYPTION_KEY=replace-with-prod-token-encryption-key
AGENT_RUNTIME_CONNECTOR_SECRET=replace-with-prod-connector-secret
AGENT_RUNTIME_CONNECTOR_URL=http://google-connector:8090
AGENT_RUNTIME_SANDBOX_URL=http://sandbox:8765
AGENT_RUNTIME_SANDBOX_TOKEN=replace-with-prod-sandbox-token
OPENAI_API_BASE_URL=https://api.1min.ai/openai/v1
OPENAI_API_KEY=replace-with-1min-or-openai-key
AGENT_RUNTIME_SMALL_TASK_MODEL=gpt-4.1-mini
AGENT_RUNTIME_GOOGLE_CLIENT_ID=
AGENT_RUNTIME_GOOGLE_CLIENT_SECRET=
AGENT_RUNTIME_GOOGLE_REDIRECT_URI=https://mini-hermes.ducnq.io.vn/api/v1/agent-runtime/drive/callback
FRONTEND_BUILD_DIR=/app/packages/backend/weai/frontend
ENABLE_VERSION_UPDATE_CHECK=false
USE_SLIM_DOCKER=true
ANONYMIZED_TELEMETRY=false
CORS_ALLOW_ORIGIN=https://mini-hermes.ducnq.io.vn
DATA_DIR=/app/data
STATIC_DIR=/app/data/static
