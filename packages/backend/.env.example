# Copy to packages/backend/.env for running the backend, worker and connector locally.
# Run Python commands from packages/backend so DATA_DIR resolves within the repo.
DATA_DIR=../../.data/local
STATIC_DIR=../../.data/local/static
USE_SLIM_DOCKER=true
CORS_ALLOW_ORIGIN=http://127.0.0.1:5173
# PostgreSQL dev container started by start-dev.ps1; URL is also used by the worker.
DATABASE_URL=postgresql://minihermes:replace-with-local-database-password@127.0.0.1:5433/minihermes
WEBUI_SECRET_KEY=replace-with-long-random-secret
MH_TOKEN_ENCRYPTION_KEY=replace-with-independent-long-random-secret
MH_CONNECTOR_SECRET=replace-with-another-long-random-secret
MH_CONNECTOR_URL=http://127.0.0.1:8090
MH_SANDBOX_URL=http://127.0.0.1:8765
MH_SANDBOX_TOKEN=replace-with-independent-sandbox-token

# SeaweedFS started by scripts/dev-seaweedfs.ps1.
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_BUCKET_NAME=mini-hermes
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=secret
S3_ADDRESSING_STYLE=path

# 1min.AI OpenAI-compatible API base URL. Put your 1min key in OPENAI_API_KEY.
OPENAI_API_BASE_URL=https://api.1min.ai/openai/v1
OPENAI_API_KEY=
MH_SMALL_TASK_MODEL=gpt-4.1-mini

# Fill for real Google Drive OAuth and register this exact redirect URI.
MH_GOOGLE_CLIENT_ID=
MH_GOOGLE_CLIENT_SECRET=
MH_GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/v1/mini-hermes/drive/callback
