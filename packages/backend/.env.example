# Copy to packages/backend/.env for running the backend, worker and connector locally.
# Run Python commands from packages/backend so DATA_DIR resolves within the repo.
DATA_DIR=../../.data/local
STATIC_DIR=../../.data/local/static
USE_SLIM_DOCKER=true
CORS_ALLOW_ORIGIN=http://127.0.0.1:5173;http://localhost:5173
# PostgreSQL dev container started by start-dev.ps1; URL is also used by the worker.
DATABASE_URL=postgresql://weai:replace-with-local-database-password@127.0.0.1:5433/weai
WEAI_SECRET_KEY=replace-with-long-random-secret
AGENT_RUNTIME_TOKEN_ENCRYPTION_KEY=replace-with-independent-long-random-secret
AGENT_RUNTIME_CONNECTOR_SECRET=replace-with-another-long-random-secret
AGENT_RUNTIME_CONNECTOR_URL=http://127.0.0.1:8090
AGENT_RUNTIME_SANDBOX_URL=http://127.0.0.1:8765
AGENT_RUNTIME_SANDBOX_TOKEN=replace-with-independent-sandbox-token

# SeaweedFS started by scripts/dev-seaweedfs.ps1.
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_BUCKET_NAME=agent-runtime
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=secret
S3_ADDRESSING_STYLE=path

# 1min.AI OpenAI-compatible API base URL. Put your 1min key in OPENAI_API_KEY.
OPENAI_API_BASE_URL=https://api.1min.ai/openai/v1
OPENAI_API_KEY=
AGENT_RUNTIME_SMALL_TASK_MODEL=gpt-4.1-mini
AGENT_RUNTIME_RESOURCE_TASK_MODEL=gpt-4.1-mini
AGENT_RUNTIME_RESOURCE_AWARE_FILES=true
AGENT_RUNTIME_RESOURCE_INDEX_WORKER_ENABLED=true
AGENT_RUNTIME_AGENT_EXECUTION_V1=true
# Hard limits apply to each final serialized JSON request sent to a model.
AGENT_REQUEST_MAX_JSON_CHARS=100000
AGENT_REQUEST_PREPARATION_MAX_JSON_CHARS=95000
AGENT_REQUEST_MAX_JSON_BYTES=380000
AGENT_CONTEXT_COMPACT_FRACTION=0.75
AGENT_TOOL_OUTPUT_MAX_TOKENS=10000
# Optional JSON map: model => tool_calling, parallel_tool_calls, context_window_tokens, max_output_tokens.
AGENT_RUNTIME_MODEL_CAPABILITIES_JSON={}

# Fill for real Google Drive OAuth and register this exact redirect URI.
AGENT_RUNTIME_GOOGLE_CLIENT_ID=
AGENT_RUNTIME_GOOGLE_CLIENT_SECRET=
AGENT_RUNTIME_GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/v1/agent-runtime/drive/callback
AGENT_RUNTIME_GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file

# Google Login OAuth & Google Drive Picker
WEAI_URL=http://127.0.0.1:8080
ENABLE_OAUTH=true
ENABLE_OAUTH_SIGNUP=true
DEFAULT_USER_ROLE=pending
OAUTH_ALLOWED_DOMAINS=*
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/oauth/google/login/callback
ENABLE_GOOGLE_DRIVE_INTEGRATION=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=
