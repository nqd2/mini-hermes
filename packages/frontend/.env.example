# Copy to packages/frontend/.env for the Vite dev server.
# Vite serves the UI on 5173; browser API calls go directly to backend on 8080.
# Keep LLM and Google secrets in backend/.env.
VITE_WEBUI_BACKEND_URL=http://127.0.0.1:8080
# Fallback proxy for legacy relative URLs.
WEBUI_BACKEND_URL=http://127.0.0.1:8080
