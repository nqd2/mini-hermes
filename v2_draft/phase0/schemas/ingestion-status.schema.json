{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-hermes.invalid/v2/draft/ingestion-status.schema.json",
  "title": "Proposed V2 ingestion status",
  "description": "Structural validation only; transitions, source integrity and independent coverage proofs require service checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "job_id", "document_id", "revision", "source_sha256", "source_state", "integrity_status", "index_state", "index_build_id", "parser_coverage", "index_coverage", "problem", "updated_at"],
  "properties": {
    "contract_version": {"const": "2.0-draft"},
    "job_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "revision": {"const": 1},
    "source_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "source_state": {"enum": ["STAGED", "VERIFIED", "COMMITTED", "AVAILABLE", "FAILED"]},
    "integrity_status": {"enum": ["UNKNOWN", "VERIFIED", "FAILED"]},
    "index_state": {"enum": ["NOT_REQUESTED", "REQUESTED", "RUNNING", "VERIFYING", "READY", "FAILED"]},
    "index_build_id": {"type": ["string", "null"], "minLength": 1},
    "parser_coverage": {"oneOf": [{"type": "null"}, {"$ref": "coverage-proof.schema.json"}]},
    "index_coverage": {"oneOf": [{"type": "null"}, {"$ref": "coverage-proof.schema.json"}]},
    "problem": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "request_id"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"},
            "request_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source_state": {"const": "STAGED"}}, "required": ["source_state"]},
      "then": {"properties": {"source_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"source_state": {"enum": ["VERIFIED", "COMMITTED", "AVAILABLE"]}}, "required": ["source_state"]},
      "then": {"properties": {"source_sha256": {"type": "string"}}}
    },
    {
      "if": {"properties": {"index_state": {"enum": ["RUNNING", "VERIFYING", "READY"]}}, "required": ["index_state"]},
      "then": {"properties": {"index_build_id": {"type": "string"}}}
    },
    {
      "if": {"properties": {"index_state": {"const": "READY"}}, "required": ["index_state"]},
      "then": {"properties": {"source_state": {"const": "AVAILABLE"}, "parser_coverage": {"type": "object"}, "index_coverage": {"type": "object"}}}
    }
  ]
}
